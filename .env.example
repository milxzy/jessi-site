# leave both empty to run on the built-in mock store (the design presentation needs nothing else)
# your-store.myshopify.com, no protocol
VITE_SHOPIFY_STORE_DOMAIN=
# the PUBLIC storefront access token from the Headless channel. never put the admin api token here.
VITE_SHOPIFY_STOREFRONT_TOKEN=
# optional: the handle of the shopify blog that holds journal entries (defaults to "journal")
VITE_SHOPIFY_JOURNAL_BLOG=journal

# landing page (design E) waitlist. paste the `action` URL from Mailchimp: Audience > Signup forms > Embedded forms.
# looks like https://yourname.us21.list-manage.com/subscribe/post?u=XXXX&id=YYYY. leave empty to preview the page without sending anything.
VITE_MAILCHIMP_FORM_ACTION=
